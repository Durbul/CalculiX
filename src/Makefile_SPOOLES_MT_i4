INCLUDES=../../spooles.2.2

LIBS = \
  ../../spooles.2.2/spooles.a \
  ../../arpack/libarpack_arm.a \
  -lpthread -lm -lc -L/opt/homebrew/opt/libomp/lib -lomp \
  -framework Accelerate

CFLAGS = -Wall -O0 -g -I $(INCLUDES) -DARCH="Linux" -DSPOOLES -DARPACK -DMATRIXSTORAGE -DNETWORKOUT -DUSE_MT=1
FFLAGS = -Wall -O0 -g -fopenmp -cpp

CC=gcc-16
FC=gfortran-16

.c.o :
	$(CC) $(CFLAGS) -c $<
.f.o :
	$(FC) $(FFLAGS) -c $<

include Makefile.inc

SCCXMAIN = CalculiX.c

OCCXF = $(SCCXF:.f=.o)
OCCXC = $(SCCXC:.c=.o)
OCCXMAIN = $(SCCXMAIN:.c=.o)

CalculiX_SPOOLES_MT_i4: $(OCCXMAIN) libCalculiX.a
	$(CC) $(CFLAGS) -c CalculiX.c; $(FC) -o $@ $(OCCXMAIN) libCalculiX.a $(LIBS) -fopenmp
#	./date.pl; $(CC) $(CFLAGS) -c CalculiX.c; $(FC) -o $@ $(OCCXMAIN) libCalculiX.a $(LIBS) -fopenmp

libCalculiX.a: $(OCCXF) $(OCCXC)
	ar vr $@ $?

doc:
	cd ../doc; latexmk -pdf -ps CalculiX.tex

clean:
	rm -rf *.o *.a
